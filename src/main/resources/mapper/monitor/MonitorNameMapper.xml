<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cmbchina.infrastructure.monitor.dao.mapper.MonitorNameMapper">
    <select id="findInterfaces" resultType="com.cmbchina.infrastructure.monitor.dao.mapper.MonitorNameRecord">
        SELECT id, name
        FROM api_interface
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>

    <select id="findExperts" resultType="com.cmbchina.infrastructure.monitor.dao.mapper.MonitorNameRecord">
        SELECT agent_id AS id, task_name AS name
        FROM operation_task
        WHERE agent_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>
