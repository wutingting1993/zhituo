# 部署时分别配置智拓服务、接口配置服务、接口执行服务；各服务账号可以不同。
MYSQL_HOST=mysql.example.invalid
MYSQL_PORT=3306
MYSQL_DATABASE=zhituo
MYSQL_USER=<service-user>
MYSQL_PASSWORD=<set-in-deployment-secret>

# 仅智拓服务需要。填写已配置的 ClickHouse API 地址前缀。
APP_MONITOR_CLICKHOUSE_BASE_URL=http://clickhouse-api.example.invalid/api/
APP_MONITOR_MOCK_ENABLED=false
